    data?: string;
    /** Add a typed parameter (key=value, key[sub]=value, key[]=value) */
    field?: Array<string>;
    /** Add a string parameter without JSON parsing */
    rawField?: Array<string>;
    /** Add a HTTP request header in key:value format */
    header?: Array<string>;
    /** The file to use as body for the HTTP request (use "-" to read from standard input) */
    input?: string;
    /** Do not print the response body */
    silent?: boolean;
    /** Show the resolved request without sending it */
    dryRun?: boolean;
};

export type SchemaParams = {
    /** Show all endpoints in a flat list */
    all?: boolean;
    /** Search endpoints by keyword */
    search?: string;
};

export type WasmSplitParams = {
    /** Path to the wasm file */
    input?: string;
    /** Path to the output wasm file (default: modify input in place) */
    out?: string;
    /** Path to the output debug wasm file (default: debug data stays in the input) */
    debugOut?: string;
    /** Strip the file of debug info */
    strip?: boolean;
    /** Strip the file of symbol names (only with --strip) */
    stripNames?: boolean;
    /** Do not print the build id */
    quiet?: boolean;
    /** Explicit build id to use, as a UUID */
    buildId?: string;
    /** URL for browsers to fetch the separate DWARF debug symbol file */
    externalDwarfUrl?: string;
};

